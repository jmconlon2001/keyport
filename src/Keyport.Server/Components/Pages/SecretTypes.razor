@page "/secret-types"
@attribute [Authorize]
@using Keyport.Core.Secrets.Types
@using Microsoft.Extensions.Options
@using Keyport.Server.Configuration
@inject IOptions<KeyportOptions> Options

<PageTitle>Secret types · Keyport</PageTitle>

<div class="page-header">
    <div>
        <h1>Secret types</h1>
        <p class="page-subtitle">Every kind of secret Keyport can store: its fields, which ones are encrypted, and what applications receive. Admins can add new types without code.</p>
    </div>
</div>

@foreach (var group in SecretTypeRegistry.Current.ByCategory())
{
    <h2 class="h5 mt-4 mb-3">@Categories.Title(group.Key)</h2>
    <div class="row g-3">
        @foreach (var t in group)
        {
            <div class="col-xl-6">
                <div class="card h-100">
                    <div class="card-header">
                        <h3 class="d-flex align-items-center gap-2"><TypeIcon Type="new SecretType(t.Key)" /> @t.Title</h3>
                        <span class="pill @(t.Source == "built-in" ? "pill-muted" : "pill-accent")">@t.Source</span>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-2">@t.Description</p>
                        @if (!t.SensitiveFields.Any() && t.Source != "built-in")
                        {
                            <div class="alert alert-warning small py-2"><i class="i i-alert"></i> No field of this type is encrypted: everything entered is stored in clear. Check the definition marks secret values as <code>"sensitive": true</code>.</div>
                        }
                        <div class="small mb-3">Type key <code>@t.Key</code>@if (t.Tester is not null){<span> · test: <code>@t.Tester</code></span>}</div>
                        <div class="table-wrap">
                            <table class="table field-table">
                                <thead><tr><th>Field</th><th>Stored</th><th>Rules</th></tr></thead>
                                <tbody>
                                    @foreach (var f in t.Fields)
                                    {
                                        <tr>
                                            <td>@f.Label <div class="cell-sub cell-mono">@f.Key · @f.Kind.ToString().ToLowerInvariant()</div></td>
                                            <td>@if (f.Sensitive){<span class="pill pill-accent"><i class="i i-lock"></i> encrypted</span>} else {<span class="pill pill-muted">clear</span>}</td>
                                            <td class="cell-sub">
                                                @string.Join(" · ", Rules(t, f))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @foreach (var g in t.RequireOneOf)
                        {
                            <div class="small mt-2"><strong>At least one of:</strong> @string.Join(", ", g.Select(k => t.Field(k)?.Label ?? k))</div>
                        }
                        @if (t.Outputs.Count > 0)
                        {
                            <div class="small mt-2"><strong>Applications receive:</strong> @string.Join(", ", t.Outputs.Select(o => $"{o.Label} ({o.Renderer})"))</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="card mt-4 help-card">
    <div class="card-body">
        <h3 class="h6"><i class="i i-plus"></i> Adding your own type</h3>
        <p class="small mb-2">Put a JSON file in <code>@System.IO.Path.Combine(Options.Value.DataPath, "secret-types")</code> (or add it under <code>Keyport:SecretTypes</code> in configuration) and restart. Keyport checks every definition at startup and refuses to start with a clear message if one is invalid. Example:</p>
        <pre class="cs-preview small mb-0">@Example</pre>
    </div>
</div>

@code {
    private static string Label(SecretTypeDefinition t, string key) => (t.Field(key)?.Label ?? key).ToLowerInvariant();

    private static IEnumerable<string> Rules(SecretTypeDefinition t, FieldDefinition f)
    {
        if (f.Required) yield return f.RequiredUnless.Count > 0 ? $"required unless {string.Join(" or ", f.RequiredUnless.Select(k => Label(t, k)))} is set" : "required";
        if (f.Recommended) yield return "recommended";
        if (f.Advanced) yield return "advanced";
        if (f.Sensitive && f.CopyOnPromote) yield return "copied to other environments";
        if (f.Sensitive && !f.CopyOnPromote) yield return "never copied";
        if (f.Generate) yield return "generator";
        if (f.Default is not null) yield return $"default {f.Default}";
        if (f.DisabledWhen is not null) yield return $"off when {Label(t, f.DisabledWhen)} is on";
        if (f.Options.Count > 0) yield return "choices: " + string.Join(", ", f.Options.Select(o => o.Split('.')[^1]));
        if (f.Pattern is not null) yield return "format checked";
    }

    // Same as docs/secret-types/elasticsearch.json.
    private const string Example = """
        {
          "key": "Elasticsearch",
          "title": "Elasticsearch cluster",
          "description": "Address and API key for an Elasticsearch cluster.",
          "category": "database",
          "icon": "database",
          "color": "#00bfb3",
          "fields": [
            { "key": "url", "label": "Cluster address", "kind": "Url", "required": true,
              "placeholder": "https://search.corp.local:9200" },
            { "key": "apiKey", "label": "API key (encoded)", "kind": "Password", "sensitive": true, "required": true,
              "help": "The 'encoded' value Kibana shows when you create the key." },
            { "key": "index", "label": "Default index", "placeholder": "e.g. telemetry-*", "advanced": true }
          ],
          "outputs": [
            { "key": "authorizationHeader", "label": "Authorization header", "renderer": "template",
              "settings": { "template": "ApiKey {{apiKey}}" } }
          ],
          "tester": "tcp"
        }
        """;
}
