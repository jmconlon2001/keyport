@page "/secrets/{EnvName}/new"
@page "/secret/{Id:int}"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits AppPageBase
@implements IDisposable
@inject SecretService Secrets
@inject ApiClientService ClientService
@inject ConnectionTester Tester
@inject AuditService Audit
@inject IJSRuntime JS

<PageTitle>@(IsNew ? "New secret" : detail?.Name ?? "Secret") · Keyport</PageTitle>

@if (env is null || (!IsNew && detail is null))
{
    @if (loaded)
    {
        <div class="card"><div class="empty"><i class="i i-alert"></i><h3>Not found</h3><p>This secret doesn't exist, or you don't have access to it.</p><a class="btn btn-outline-secondary" href="secrets">Back to secrets</a></div></div>
    }
}
else
{
    <div class="page-header">
        <div>
            <div class="breadcrumbs">
                <a href="secrets">Secrets</a><i class="i i-chevron-right"></i>
                <a href="@($"secrets/{env.Name.ToLowerInvariant()}")">@env.Name</a><i class="i i-chevron-right"></i>
                <span>@(IsNew ? "New" : detail!.Name)</span>
            </div>
            <h1 class="d-flex align-items-center gap-3 flex-wrap">
                <TypeIcon Type="req.Type" />
                <span class="@(IsNew ? "" : "mono")">@(IsNew ? (promotedFrom is null ? $"Add a secret to {env.Name}" : $"Copy to {env.Name}") : detail!.Name)</span>
                <EnvBadge Env="env" />
                @if (promotedFrom is not null){<span class="pill pill-warning">Not saved yet</span>}
            </h1>
            @if (IsNew)
            {
                <p class="page-subtitle">Fill in the details below. Everything sensitive is encrypted, and only applications you allow can read it.</p>
            }
        </div>
        @if (!IsNew)
        {
            <div class="page-actions">
                @if (req.Type.IsConnection())
                {
                    <button class="btn btn-outline-secondary" disabled="@Busy" @onclick="TestStoredAsync" title="Try to connect to the database with these details"><i class="i i-zap"></i> Test connection</button>
                }
                @if (nextEnvs.Count > 0)
                {
                    <button class="btn btn-outline-secondary" @onclick="() => showPromote = true" title="Create the same secret in another environment"><i class="i i-promote"></i> Copy to…</button>
                }
                @if (canEdit)
                {
                    <button class="btn btn-outline-danger" @onclick="() => confirm = Pending.Delete"><i class="i i-trash"></i> Delete</button>
                }
            </div>
        }
    </div>

    @if (Created == 1 && !IsNew)
    {
        <div class="next-step">
            <div class="next-step-icon"><i class="i i-check"></i></div>
            <div class="flex-grow-1">
                <strong>Secret saved.</strong> Next step: choose which application may read it. You'll get a key to hand to the application's owner.
            </div>
            <a class="btn btn-primary" href="@GiveAccessUrl"><i class="i i-plug"></i> Give an application access</a>
        </div>
    }
    @if (env.Protected)
    {
        <div class="env-banner" style="--env:@env.Color"><i class="i i-lock"></i><div><strong>@env.Name is a protected environment.</strong> You'll be asked for a reason (for example a change ticket number) before viewing or changing anything.</div></div>
    }
    @if (promotedFrom is not null)
    {
        <div class="action-needed @(Missing.Count == 0 ? "ready" : "")" role="status">
            <div class="action-needed-icon"><i class="i @(Missing.Count == 0 ? "i-check" : "i-alert")"></i></div>
            <div class="flex-grow-1">
                @if (Missing.Count > 0)
                {
                    <strong>Not saved yet. One more step.</strong>
                    <div>Settings@(req.Type == SecretType.Generic ? "" : " and username") were copied from <strong>@promotedFrom</strong>, but the @CopySecretWord is <strong>never copied</strong>. Enter the @env.Name @CopySecretWord@(req.Type == SecretType.Generic ? "" : " (or generate a new one)"), then press <strong>Save secret</strong>.</div>
                    <div class="small mt-1">Still needed: @string.Join(", ", Missing)</div>
                }
                else
                {
                    <strong>Ready to save.</strong>
                    <div>Press <strong>Save secret</strong> to create it in @env.Name. Nothing is saved until you do.</div>
                }
            </div>
            <button type="button" class="btn btn-primary" @onclick="FocusNextStepAsync">
                <i class="i @(Missing.Count > 0 ? "i-key" : "i-check")"></i> @(Missing.Count > 0 ? $"Enter {CopySecretWord}" : "Go to Save")
            </button>
        </div>
    }
    @if (testResult is not null)
    {
        <div class="alert @(testResult.Success ? "alert-success" : "alert-danger") d-flex gap-2 align-items-start">
            <i class="i @(testResult.Success ? "i-check" : "i-alert") mt-1"></i>
            <div><strong>@(testResult.Success ? "Connection works." : "Couldn't connect.")</strong> @testResult.Message <span class="text-muted">(@testResult.ElapsedMs.ToString("0") ms)</span>
                @if (!testResult.Success){<div class="small mt-1">Check the server name, port, and login with the database owner. The server running Keyport may also need firewall access to the database.</div>}
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-xl-8">
            <EditForm Model="req" OnValidSubmit="SaveAsync">
                <div class="card">
                    <div class="card-body">
                        <fieldset disabled="@(!canEdit)">
                            @if (IsNew)
                            {
                                <div class="form-section">
                                    <div class="form-section-title"><span class="step">1</span> What kind of secret is it?</div>
                                    <div class="type-picker type-picker-lg">
                                        @foreach (var t in Enum.GetValues<SecretType>())
                                        {
                                            <div class="type-option @(req.Type == t ? "selected" : "")" role="radio" aria-checked="@(req.Type == t)" tabindex="0"
                                                 @onclick="() => req.Type = t" @onkeydown="e => TypeKey(e, t)">
                                                <TypeIcon Type="t" />
                                                <div><div>@t.FriendlyTitle()</div><div class="type-option-desc">@t.FriendlyDescription()</div></div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="form-section">
                                <div class="form-section-title">@if (IsNew){<span class="step">2</span>} Name and description</div>
                                @if (IsNew)
                                {
                                    <div class="row g-3">
                                        <div class="col-md-5">
                                            <label class="form-label" for="folder">Folder <span class="opt">optional</span></label>
                                            <input id="folder" class="form-control" list="folders" @bind="folder" @bind:event="oninput" placeholder="e.g. billing" autocomplete="off" />
                                            <datalist id="folders">@foreach (var f in existingFolders){<option value="@f"></option>}</datalist>
                                            <div class="form-text">Group related secrets, usually by application or team. Pick an existing folder or type a new one.</div>
                                        </div>
                                        <div class="col-md-7">
                                            <label class="form-label" for="name">Name <span class="req">*</span></label>
                                            <input id="name" class="form-control" @bind="shortName" @bind:event="oninput" placeholder="e.g. Main database" autocomplete="off" />
                                            <div class="form-text">Type it however you like; it's converted to a safe name automatically.</div>
                                        </div>
                                        <div class="col-12">
                                            <div class="name-preview @(nameTaken ? "taken" : "")">
                                                <span class="text-muted">Saved as</span>
                                                <code>@(string.IsNullOrEmpty(FullName) ? "…" : FullName)</code>
                                                @if (nameTaken){<span class="text-danger small"><i class="i i-alert"></i> already exists in @env.Name</span>}
                                                else if (!string.IsNullOrEmpty(FullName)){<span class="text-muted small">(applications use this name to ask for it)</span>}
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div class="row g-3 @(IsNew ? "mt-0" : "")">
                                    <div class="col-12">
                                        <label class="form-label" for="desc">Description <span class="opt">recommended</span></label>
                                        <input id="desc" class="form-control" @bind="req.Metadata.Description" placeholder="What it's for and who to contact, e.g. 'Billing app database. Owner: Payments team'" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="tags">Tags <span class="opt">optional</span></label>
                                        <input id="tags" class="form-control" @bind="req.Tags" placeholder="e.g. finance, nightly-jobs" />
                                        <div class="form-text">Comma-separated words that make secrets easier to find.</div>
                                    </div>
                                </div>
                            </div>

                            @if (req.Type.IsConnection())
                            {
                                <div class="form-section">
                                    <div class="form-section-title">@if (IsNew){<span class="step">3</span>} Where is the database?</div>
                                    <p class="form-hint">Ask the database owner (DBA) for these details if you don't have them.</p>
                                    <div class="row g-3">
                                        <div class="col-md-8">
                                            <label class="form-label" for="host">Server name <span class="req">*</span></label>
                                            <input id="host" class="form-control mono-input" @bind="req.Metadata.Host" @bind:event="oninput" placeholder="@(req.Type == SecretType.OracleConnection ? "e.g. ora-prod-01.corp.local" : "e.g. sql-prod-01.corp.local")" />
                                            <div class="form-text">@(req.Type == SecretType.SqlServerConnection ? "Include the instance if there is one, e.g. sql-01\\REPORTING." : "The host name or IP address of the database server.")</div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="port">Port <span class="opt">optional</span></label>
                                            <input id="port" type="number" class="form-control mono-input" @bind="req.Metadata.Port" @bind:event="oninput" placeholder="@(req.Type == SecretType.OracleConnection ? "1521" : "1433")" />
                                            <div class="form-text">Leave blank for the usual @(req.Type == SecretType.OracleConnection ? "1521" : "1433").</div>
                                        </div>
                                        @if (req.Type == SecretType.OracleConnection)
                                        {
                                            <div class="col-12">
                                                <label class="form-label" for="svc">Service name <span class="req">*</span></label>
                                                <input id="svc" class="form-control mono-input" @bind="req.Metadata.ServiceName" @bind:event="oninput" placeholder="e.g. BILLPDB" />
                                                <div class="form-text">The Oracle service the application connects to. Older databases may use a SID instead (under Advanced settings).</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-12">
                                                <label class="form-label" for="db">Database name <span class="opt">recommended</span></label>
                                                <input id="db" class="form-control mono-input" @bind="req.Metadata.Database" @bind:event="oninput" placeholder="e.g. Billing" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else if (req.Type.IsCredential())
                            {
                                <div class="form-section">
                                    <div class="form-section-title">@if (IsNew){<span class="step">3</span>} What is it for?</div>
                                    <div class="row g-3">
                                        @if (req.Type == SecretType.ServiceAccount)
                                        {
                                            <div class="col-md-5">
                                                <label class="form-label" for="domain">Domain <span class="opt">optional</span></label>
                                                <input id="domain" class="form-control mono-input" @bind="req.Metadata.Domain" placeholder="e.g. CORP" />
                                                <div class="form-text">The part before the \ in CORP\svc_batch.</div>
                                            </div>
                                        }
                                        <div class="col-md-@(req.Type == SecretType.ServiceAccount ? "7" : "12")">
                                            <label class="form-label" for="url">@(req.Type == SecretType.BasicAuth ? "Website or API address" : "Used by") <span class="opt">optional</span></label>
                                            <input id="url" class="form-control @(req.Type == SecretType.BasicAuth ? "mono-input" : "")" @bind="req.Metadata.Url" placeholder="@(req.Type == SecretType.BasicAuth ? "e.g. https://api.partner.example" : "e.g. Nightly invoice job")" />
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="form-section">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                    <div class="form-section-title mb-0">@if (IsNew){<span class="step">@(req.Type == SecretType.Generic ? "3" : "4")</span>} @(req.Type == SecretType.Generic ? "The secret value" : "Login details") <i class="i i-lock" title="Encrypted"></i></div>
                                    @if (!IsNew && canEdit)
                                    {
                                        <div class="form-check form-switch m-0">
                                            <input class="form-check-input" type="checkbox" id="chg" @bind="changeValues" />
                                            <label class="form-check-label" for="chg">Change @(req.Type == SecretType.Generic ? "value" : "login details") <span class="text-muted">(keeps the old version)</span></label>
                                        </div>
                                    }
                                </div>
                                @if (IsNew || changeValues)
                                {
                                    <div class="row g-3">
                                        @if (req.Type == SecretType.Generic)
                                        {
                                            <div class="col-12">
                                                <label class="form-label" for="val">Value <span class="req">*</span></label>
                                                <textarea id="val" class="form-control mono-input @(NeedsCopiedValue(payload.Value) ? "needs-input" : "")" rows="3" @bind="payload.Value" @bind:event="oninput" autocomplete="off" spellcheck="false"></textarea>
                                                @if (NeedsCopiedValue(payload.Value)){<div class="form-text needs-input-text"><i class="i i-alert"></i> Not copied from @promotedFrom. Enter the @env.Name value.</div>}
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-md-6">
                                                <label class="form-label" for="user">Username <span class="req">*</span></label>
                                                <input id="user" class="form-control mono-input" @bind="payload.Username" @bind:event="oninput" autocomplete="off" disabled="@IntegratedSql" placeholder="e.g. svc_billing" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label" for="pw">Password <span class="req">*</span></label>
                                                <div class="input-group">
                                                    <input id="pw" type="@(showPassword ? "text" : "password")" class="form-control mono-input @(NeedsCopiedValue(payload.Password) && !IntegratedSql ? "needs-input" : "")" @bind="payload.Password" @bind:event="oninput" autocomplete="new-password" disabled="@IntegratedSql" />
                                                    <button type="button" class="btn btn-outline-secondary" title="@(showPassword ? "Hide" : "Show") password" @onclick="() => showPassword = !showPassword"><i class="i @(showPassword ? "i-eye-off" : "i-eye")"></i></button>
                                                    <button type="button" class="btn btn-outline-secondary" title="Generate a strong password" @onclick="Generate"><i class="i i-shuffle"></i> <span class="d-none d-sm-inline">Generate</span></button>
                                                </div>
                                                @if (NeedsCopiedValue(payload.Password) && !IntegratedSql){<div class="form-text needs-input-text"><i class="i i-alert"></i> Not copied from @promotedFrom. Enter the @env.Name password.</div>}
                                                <div class="form-text">Paste the password you were given, or press <strong>Generate</strong> to create a strong one. If you generate one, remember to set it on the database or system too.</div>
                                            </div>
                                        }
                                        @if (!IsNew)
                                        {
                                            <div class="col-12">
                                                <label class="form-label" for="cmt">Why are you changing it? <span class="opt">optional</span></label>
                                                <input id="cmt" class="form-control" @bind="req.Comment" placeholder="e.g. quarterly password change" />
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @if (revealed is null)
                                    {
                                        <div class="secret-field">
                                            <span class="value masked">••••••••••••••••</span>
                                            <button type="button" class="btn" disabled="@Busy" @onclick="() => confirm = Pending.Reveal"><i class="i i-eye"></i> Show</button>
                                        </div>
                                        <div class="form-text">Hidden for safety. Showing it is recorded, and it hides again after @RevealSeconds seconds.</div>
                                    }
                                    else
                                    {
                                        <div class="vstack gap-2">
                                            @if (!string.IsNullOrEmpty(revealed.Username)){<SecretValue Label="Username" Value="@revealed.Username" OnCopy="CopyAsync" />}
                                            @if (!string.IsNullOrEmpty(revealed.Password)){<SecretValue Label="Password" Value="@revealed.Password" OnCopy="CopyAsync" />}
                                            @if (!string.IsNullOrEmpty(revealed.Value)){<SecretValue Label="Value" Value="@revealed.Value" OnCopy="CopyAsync" />}
                                            @if (req.Type.IsConnection()){<SecretValue Label="Connection string" Value="@ConnectionStringFactory.Build(req.Type, req.Metadata, revealed)" OnCopy="CopyAsync" />}
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="flex-grow-1 bar"><div class="reveal-timer" style="animation-duration:@(RevealSeconds)s"></div></div>
                                                <button type="button" class="btn btn-sm btn-ghost" @onclick="Hide"><i class="i i-eye-off"></i> Hide now</button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <div class="form-section">
                                <div class="form-section-title">Password change reminder <span class="opt">optional</span></div>
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-5">
                                        <label class="form-label" for="rot">Remind me to change it by</label>
                                        <input id="rot" type="date" class="form-control" @bind="rotateDate" />
                                    </div>
                                    <div class="col-md-7">
                                        <div class="d-flex gap-2 flex-wrap">
                                            @foreach (var (label, days) in new[] { ("In 3 months", 90), ("In 6 months", 180), ("In 1 year", 365) })
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => rotateDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(days))">@label</button>
                                            }
                                            <button type="button" class="btn btn-sm btn-ghost" @onclick="() => rotateDate = null">No reminder</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-text">Secrets past this date are flagged on the dashboard.</div>
                            </div>

                            @if (req.Type.IsConnection())
                            {
                                <details class="advanced" open="@advancedOpen">
                                    <summary @onclick="() => advancedOpen = !advancedOpen" @onclick:preventDefault="true"><i class="i i-chevron-right"></i> Advanced settings <span class="text-muted fw-normal">(only if the database owner asked for them)</span></summary>
                                    <div class="row g-3 pt-3">
                                        @if (req.Type == SecretType.OracleConnection)
                                        {
                                            <div class="col-md-6">
                                                <label class="form-label" for="sid">SID <span class="opt">instead of service name</span></label>
                                                <input id="sid" class="form-control mono-input" @bind="req.Metadata.Sid" @bind:event="oninput" />
                                            </div>
                                            <div class="col-md-6 d-flex align-items-end">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="tns" @bind="req.Metadata.UseTnsDescriptor" />
                                                    <label class="form-check-label" for="tns">Use full TNS descriptor</label>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-md-6">
                                                <label class="form-label" for="enc">Encryption</label>
                                                <select id="enc" class="form-select" @bind="req.Metadata.Encrypt">
                                                    <option value="Mandatory">Required (recommended)</option>
                                                    <option value="Strict">Strict (TDS 8.0)</option>
                                                    <option value="Optional">Optional</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label" for="app">Application name</label>
                                                <input id="app" class="form-control" @bind="req.Metadata.ApplicationName" @bind:event="oninput" />
                                            </div>
                                            <div class="col-12 d-flex flex-wrap gap-4">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="tsc" @bind="req.Metadata.TrustServerCertificate" />
                                                    <label class="form-check-label" for="tsc">Trust server certificate</label>
                                                </div>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="integ" @bind="req.Metadata.IntegratedSecurity" />
                                                    <label class="form-check-label" for="integ">Windows authentication (no password)</label>
                                                </div>
                                            </div>
                                        }
                                        <div class="col-12">
                                            <label class="form-label" for="extra">Additional driver options</label>
                                            <input id="extra" class="form-control mono-input" @bind="req.Metadata.ExtraOptions" @bind:event="oninput" placeholder="@(req.Type == SecretType.OracleConnection ? "Pooling=true;Max Pool Size=50" : "MultipleActiveResultSets=True;Connect Timeout=30")" />
                                        </div>
                                        @if (IsNew || changeValues)
                                        {
                                            <div class="col-12">
                                                <label class="form-label" for="override">Full connection string (replaces everything above)</label>
                                                <textarea id="override" class="form-control mono-input" rows="2" @bind="payload.ConnectionStringOverride" @bind:event="oninput" placeholder="Leave empty unless you were given a complete connection string" spellcheck="false"></textarea>
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </fieldset>
                    </div>
                    @if (canEdit)
                    {
                        <div class="card-body border-top form-footer">
                            @if (Missing.Count > 0)
                            {
                                <span class="still-needed"><i class="i i-info"></i> Still needed: @string.Join(", ", Missing)</span>
                            }
                            else
                            {
                                <span class="text-muted small">@(IsNew ? $"Will be available to allowed applications in {env.Name}." : changeValues ? "Saving creates a new version; the old one is kept." : "Saving updates the description and settings.")</span>
                            }
                            <div class="d-flex gap-2 ms-auto">
                                @if (IsNew && req.Type.IsConnection())
                                {
                                    <button type="button" class="btn btn-outline-secondary" disabled="@(Busy || Missing.Count > 0)" @onclick="TestFormAsync" title="Check that the database accepts these details before saving"><i class="i i-zap"></i> Test</button>
                                }
                                <a class="btn btn-outline-secondary" href="@($"secrets/{env.Name.ToLowerInvariant()}")">Cancel</a>
                                <button type="submit" id="save-secret" class="btn btn-primary" disabled="@(Busy || Missing.Count > 0)"><i class="i i-check"></i> @(IsNew ? "Save secret" : "Save changes")</button>
                            </div>
                        </div>
                    }
                </div>
            </EditForm>
        </div>

        <div class="col-xl-4">
            @if (!IsNew)
            {
                <div class="card mb-4">
                    <div class="card-header"><h3><i class="i i-plug"></i> Applications that can read this</h3><span class="pill pill-muted">@accessClients.Count</span></div>
                    <div class="card-body">
                        @if (accessClients.Count == 0)
                        {
                            <p class="text-muted mb-3">No application can read this secret yet.</p>
                        }
                        else
                        {
                            <ul class="plain-list mb-3">
                                @foreach (var c in accessClients)
                                {
                                    <li><i class="i i-plug text-muted"></i> <strong>@c.Name</strong> @if (c.Disabled){<span class="pill pill-danger">disabled</span>} <span class="pill @(IsOldKey(c.KeyCreatedUtc) ? "pill-warning" : "pill-muted")" title="Key issued @c.KeyCreatedUtc.ToString("d MMM yyyy")">key @Age(c.KeyCreatedUtc)</span><div class="cell-sub">via <code>@c.Grants.First(g => Keyport.Core.Secrets.SecretNames.MatchesGrant(detail!.Name, g.Pattern)).Pattern</code></div></li>
                                }
                            </ul>
                        }
                        @if (canEdit)
                        {
                            <a class="btn btn-outline-secondary w-100" href="@GiveAccessUrl"><i class="i i-plus"></i> Give an application access</a>
                        }
                    </div>
                </div>
            }

            @if (req.Type.IsConnection())
            {
                <div class="card mb-4">
                    <div class="card-header"><h3><i class="i i-code"></i> What the application receives</h3></div>
                    <div class="card-body">
                        <div class="cs-preview">@Preview()</div>
                        <div class="form-text mt-2">This connection string is built automatically. The password is hidden here.</div>
                    </div>
                </div>
            }

            @if (IsNew)
            {
                <div class="card help-card">
                    <div class="card-body">
                        <h3 class="h6"><i class="i i-info"></i> Tips</h3>
                        <ul class="small mb-0">
                            <li>Each environment (Dev, Test, Upgrade, Prod) keeps its <strong>own</strong> copy with its own password.</li>
                            <li>Use the same name in every environment so applications don't need changing between them.</li>
                            <li>Nothing can read this secret until you <strong>give an application access</strong> after saving.</li>
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <div class="card mb-4">
                    <div class="card-header"><h3><i class="i i-info"></i> Details</h3></div>
                    <div class="card-body">
                        <dl class="kv">
                            <dt>Type</dt><dd>@req.Type.FriendlyTitle()</dd>
                            <dt>Environment</dt><dd><EnvBadge Env="env" /></dd>
                            <dt>Created</dt><dd>@detail!.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC<div class="cell-sub">by @detail.CreatedBy</div></dd>
                            <dt>Last changed</dt><dd>@detail.UpdatedUtc.ToString("yyyy-MM-dd HH:mm") UTC<div class="cell-sub">by @detail.UpdatedBy</div></dd>
                            <dt>Your access</dt><dd>@(canEdit ? "Can view and change" : "Can view")</dd>
                        </dl>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header"><h3><i class="i i-history"></i> History</h3><span class="pill pill-muted">@detail!.Versions.Count @(detail.Versions.Count == 1 ? "version" : "versions")</span></div>
                    <div class="card-body">
                        <ul class="timeline">
                            @foreach (var v in detail.Versions)
                            {
                                <li class="@(v.Version == detail.CurrentVersion ? "current" : "")">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <div class="fw-semibold">Version @v.Version @if (v.Version == detail.CurrentVersion){<span class="pill pill-accent ms-1">in use</span>}</div>
                                            <div class="cell-sub">@v.CreatedBy · @v.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</div>
                                            @if (!string.IsNullOrEmpty(v.Comment)){<div class="small mt-1">@v.Comment</div>}
                                        </div>
                                        @if (canEdit && v.Version != detail.CurrentVersion)
                                        {
                                            <button class="btn btn-sm btn-ghost" title="Go back to this version" @onclick="() => { rollbackVersion = v.Version; confirm = Pending.Rollback; }"><i class="i i-history"></i> Restore</button>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>

    <ConfirmDialog Show="confirm == Pending.Reveal" Title="Show this secret?" Message="@($"The values will be shown for {RevealSeconds} seconds. Your name and the time are recorded.")"
                   ConfirmText="Show" Env="env" OnConfirm="RevealAsync" OnCancel="() => confirm = Pending.None" />
    <ConfirmDialog Show="confirm == Pending.Save" Title="Save changes" Message="@($"Save changes to {FullNameOrExisting} in {env.Name}?")"
                   ConfirmText="Save" Env="env" OnConfirm="DoSaveAsync" OnCancel="() => confirm = Pending.None" />
    <ConfirmDialog Show="confirm == Pending.Delete" Title="Delete this secret?" Danger="true" AskReason="true" ConfirmText="Delete permanently"
                   Message="@($"{detail?.Name} and all of its history will be deleted from {env.Name}. Applications using it will stop working straight away. This can't be undone.")"
                   Env="env" OnConfirm="DeleteAsync" OnCancel="() => confirm = Pending.None" />
    <ConfirmDialog Show="confirm == Pending.Rollback" Title="@($"Go back to version {rollbackVersion}?")" ConfirmText="Restore" AskReason="true"
                   Message="@($"The values from version {rollbackVersion} become the ones in use. Applications get them straight away. Nothing is deleted.")"
                   Env="env" OnConfirm="RollbackAsync" OnCancel="() => confirm = Pending.None" />

    <Modal Show="showPromote" Title="Copy to another environment" OnClose="() => showPromote = false">
        <ChildContent>
            <p>Creates the same secret (name, settings and username) in another environment. <strong>The password is not copied</strong>: each environment must have its own, and you'll enter it on the next screen.</p>
            <div class="vstack gap-2">
                @foreach (var t in nextEnvs)
                {
                    <button class="btn btn-outline-secondary justify-content-between" disabled="@(!Access.CanEdit(t.Id))" @onclick="() => Promote(t)">
                        <span class="d-flex align-items-center gap-2"><span class="env-dot" style="--env:@t.Color"></span>@t.Name @if (t.Protected){<i class="i i-lock"></i>}</span>
                        <span class="text-muted small">@(Access.CanEdit(t.Id) ? "Copy here" : "You can't edit this environment")</span>
                    </button>
                }
            </div>
        </ChildContent>
    </Modal>
}

<ToastHost Items="Toasts" />

@code {
    [Parameter] public string? EnvName { get; set; }
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery] public int? PromoteFrom { get; set; }
    [SupplyParameterFromQuery] public int? Created { get; set; }

    private const int RevealSeconds = 30;
    private enum Pending { None, Reveal, Save, Delete, Rollback }

    private bool IsNew => Id is null;
    private bool loaded;
    private EnvironmentInfo? env;
    private SecretDetail? detail;
    private SaveSecretRequest req = new();
    private SecretPayload payload = new();
    private SecretPayload? revealed;
    private bool changeValues, showPassword, canEdit, showPromote, advancedOpen;
    private DateOnly? rotateDate;
    private Pending confirm;
    private int rollbackVersion;
    private string? promotedFrom;
    private bool focusAfterRender;
    private ConnectionTestResult? testResult;
    private List<EnvironmentInfo> nextEnvs = [];
    private CancellationTokenSource? hideCts;
    private string folder = "", shortName = "";
    private List<string> existingFolders = [];
    private HashSet<string> existingNames = [];
    private List<Keyport.Server.Data.ApiClient> accessClients = [];

    private string FullName
    {
        get
        {
            var n = SecretNames.Slugify(shortName);
            if (n.Length == 0) return "";
            var f = SecretNames.SlugifyPath(folder);
            return f.Length == 0 ? n : $"{f}/{n}";
        }
    }

    private string FullNameOrExisting => IsNew ? FullName : detail?.Name ?? "";
    private bool nameTaken => IsNew && existingNames.Contains(FullName);
    private bool IntegratedSql => req.Metadata.IntegratedSecurity && req.Type == SecretType.SqlServerConnection;
    private string GiveAccessUrl => $"clients/{env!.Name.ToLowerInvariant()}?grant={Uri.EscapeDataString(detail?.Name ?? FullName)}";

    /// <summary>Plain-language list of what still has to be filled in before saving.</summary>
    private List<string> Missing
    {
        get
        {
            var m = new List<string>();
            if (IsNew && string.IsNullOrEmpty(FullName)) m.Add("a name");
            if (nameTaken) m.Add("a different name");
            var hasOverride = !string.IsNullOrWhiteSpace(payload.ConnectionStringOverride);
            if (req.Type.IsConnection() && !hasOverride)
            {
                if (string.IsNullOrWhiteSpace(req.Metadata.Host)) m.Add("the server name");
                if (req.Type == SecretType.OracleConnection && string.IsNullOrWhiteSpace(req.Metadata.ServiceName) && string.IsNullOrWhiteSpace(req.Metadata.Sid)) m.Add("the service name");
            }
            if (IsNew || changeValues)
            {
                if (req.Type == SecretType.Generic)
                {
                    if (string.IsNullOrEmpty(payload.Value)) m.Add("the value");
                }
                else if (!IntegratedSql && !hasOverride)
                {
                    if (string.IsNullOrWhiteSpace(payload.Username)) m.Add("the username");
                    if (string.IsNullOrEmpty(payload.Password)) m.Add("the password");
                }
            }
            return m;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        revealed = null;
        testResult = null;
        changeValues = false;

        if (IsNew)
        {
            env = Environments.ByName(EnvName);
            if (env is null || !Access.CanEdit(env.Id))
            {
                env = null;
                loaded = true;
                return;
            }
            req = new SaveSecretRequest();
            payload = new SecretPayload();
            promotedFrom = null;
            folder = shortName = "";
            var names = (await Secrets.ListAsync(Access, env.Id)).Select(s => s.Name).ToList();
            existingNames = names.ToHashSet();
            existingFolders = SecretNames.Folders(names).ToList();

            if (PromoteFrom is { } src)
            {
                try
                {
                    req = await Secrets.PreparePromotionAsync(Access, src, env.Id, Ip);
                    payload = req.Payload ?? new();
                    promotedFrom = req.Comment?.Replace("promoted from ", "");
                    var slash = req.Name.LastIndexOf('/');
                    folder = slash < 0 ? "" : req.Name[..slash];
                    shortName = slash < 0 ? req.Name : req.Name[(slash + 1)..];
                    focusAfterRender = true;
                }
                catch (Exception ex) when (ex is UnauthorizedAccessException or KeyNotFoundException)
                {
                    Toast("Couldn't load the secret to copy.", error: true);
                }
            }
            canEdit = true;
        }
        else
        {
            await ReloadAsync();
        }
        loaded = true;
    }

    private async Task ReloadAsync()
    {
        detail = await Secrets.GetAsync(Access, Id!.Value);
        if (detail is null)
        {
            env = null;
            return;
        }
        env = detail.Environment;
        canEdit = Access.CanEdit(env.Id);
        req = new SaveSecretRequest
        {
            Name = detail.Name,
            Type = detail.Type,
            Metadata = detail.Metadata.Clone(),
            Tags = detail.Tags,
            RotateAfterUtc = detail.RotateAfterUtc,
        };
        rotateDate = detail.RotateAfterUtc is { } r ? DateOnly.FromDateTime(r) : null;
        payload = new SecretPayload();
        nextEnvs = Environments.All.Where(e => e.SortOrder > env.SortOrder).ToList();
        accessClients = (await ClientService.ListAsync(Access, env.Id)).Where(c => ApiClientService.IsGranted(c, detail.Name)).ToList();
    }

    /// <summary>What a copy to another environment still needs from the user: the value or the password.</summary>
    private string CopySecretWord => req.Type == SecretType.Generic ? "value" : "password";

    private bool NeedsCopiedValue(string? value) => promotedFrom is not null && string.IsNullOrEmpty(value);

    /// <summary>The field the user should fill in next on a copied secret, or the Save button once nothing is missing.</summary>
    private string NextStepElementId
    {
        get
        {
            if (Missing.Count == 0) return "save-secret";
            if (req.Type == SecretType.Generic) return "val";
            if (IntegratedSql) return "save-secret";
            return string.IsNullOrWhiteSpace(payload.Username) ? "user" : "pw";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // After "Copy to…", take the user straight to the field that wasn't copied so it's obvious the copy isn't finished.
        if (focusAfterRender && loaded && env is not null)
        {
            focusAfterRender = false;
            await JS.InvokeVoidAsync("sm.focus", NextStepElementId);
        }
    }

    private Task FocusNextStepAsync() => JS.InvokeVoidAsync("sm.focus", NextStepElementId).AsTask();

    private string Preview()
    {
        try
        {
            var p = IsNew || changeValues ? payload : new SecretPayload { Username = revealed?.Username ?? "(hidden)", Password = "x" };
            return ConnectionStringFactory.BuildMasked(req.Type, req.Metadata, p);
        }
        catch (Exception)
        {
            return "Fill in the server details to see a preview.";
        }
    }

    private void TypeKey(KeyboardEventArgs e, SecretType t)
    {
        if (e.Key is "Enter" or " ") req.Type = t;
    }

    private void Generate()
    {
        payload.Password = Keyport.Core.Crypto.PasswordGenerator.Generate(24);
        showPassword = true;
        LogAction("secret.generate-password", FullNameOrExisting, env?.Name);
    }

    private Task SaveAsync()
    {
        if (Missing.Count > 0) return Task.CompletedTask;
        if (env!.Protected)
        {
            confirm = Pending.Save;
            return Task.CompletedTask;
        }
        return DoSaveAsync(null);
    }

    private async Task DoSaveAsync(string? reason)
    {
        confirm = Pending.None;
        req.Reason = reason;
        req.RotateAfterUtc = rotateDate?.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
        req.Payload = IsNew || changeValues ? payload : null;

        if (IsNew)
        {
            req.Name = FullName;
            if (string.IsNullOrEmpty(req.Comment)) req.Comment = promotedFrom is null ? "created" : $"copied from {promotedFrom}";
            var id = 0;
            if (await RunAsync("secret.create", async () => id = await Secrets.CreateAsync(Access, env!.Id, req, Ip), null, req.Name, env!.Name))
                Nav.NavigateTo($"secret/{id}?created=1");
        }
        else if (await RunAsync("secret.update", () => Secrets.UpdateAsync(Access, Id!.Value, req, Ip), "Saved", req.Name, env!.Name))
        {
            await ReloadAsync();
            changeValues = false;
        }
    }

    private async Task RevealAsync(string? reason)
    {
        confirm = Pending.None;
        await RunAsync("secret.reveal", async () =>
        {
            revealed = await Secrets.RevealAsync(Access, Id!.Value, reason, Ip);
            hideCts?.Cancel();
            hideCts = new CancellationTokenSource();
            var token = hideCts.Token;
            _ = Task.Delay(TimeSpan.FromSeconds(RevealSeconds), token).ContinueWith(t =>
            {
                if (!t.IsCanceled) InvokeAsync(() => { revealed = null; StateHasChanged(); });
            }, TaskScheduler.Default);
        }, null, detail?.Name, env?.Name);
    }

    private void Hide()
    {
        hideCts?.Cancel();
        revealed = null;
    }

    private async Task CopyAsync((string Label, string Value) item)
    {
        var ok = await JS.InvokeAsync<bool>("sm.copy", item.Value);
        LogAction("secret.copy", $"{detail?.Name}:{item.Label}", env?.Name);
        await Audit.WriteAsync(Access.UserName, "secret.copy", AuditResult.Success, env?.Name, detail?.Name, Ip, item.Label);
        Toast(ok ? $"{item.Label} copied" : "Your browser blocked copying. Select the text and copy it manually.", error: !ok);
    }

    private async Task DeleteAsync(string? reason)
    {
        confirm = Pending.None;
        var envName = env!.Name;
        if (await RunAsync("secret.delete", () => Secrets.DeleteAsync(Access, Id!.Value, reason, Ip), null, detail?.Name, envName))
            Nav.NavigateTo($"secrets/{envName.ToLowerInvariant()}");
    }

    private async Task RollbackAsync(string? reason)
    {
        confirm = Pending.None;
        if (await RunAsync("secret.rollback", () => Secrets.RollbackAsync(Access, Id!.Value, rollbackVersion, reason, Ip), $"Version {rollbackVersion} restored", detail?.Name, env?.Name))
            await ReloadAsync();
    }

    private void Promote(EnvironmentInfo target)
    {
        showPromote = false;
        LogAction("secret.promote", $"{detail?.Name} -> {target.Name}", env?.Name);
        Nav.NavigateTo($"secrets/{target.Name.ToLowerInvariant()}/new?promoteFrom={Id}");
    }

    private async Task TestFormAsync()
    {
        Busy = true;
        testResult = await Tester.TestAsync(req.Type, req.Metadata, payload);
        Busy = false;
        await Audit.WriteAsync(Access.UserName, "secret.test-connection", testResult.Success ? AuditResult.Success : AuditResult.Failure, env?.Name, FullName, Ip, "unsaved form values");
        LogAction("secret.test-connection", FullName, env?.Name, testResult.Success ? 200 : 502, testResult.Success ? null : testResult.Message);
    }

    private async Task TestStoredAsync()
    {
        await RunAsync("secret.test-connection", async () =>
        {
            var stored = await Secrets.RevealAsync(Access, Id!.Value, env!.Protected ? "connection test" : null, Ip);
            testResult = await Tester.TestAsync(req.Type, req.Metadata, stored);
            await Audit.WriteAsync(Access.UserName, "secret.test-connection", testResult.Success ? AuditResult.Success : AuditResult.Failure, env.Name, detail!.Name, Ip, testResult.Success ? null : testResult.Message);
        }, null, detail?.Name, env?.Name);
    }

    public void Dispose() => hideCts?.Cancel();
}
