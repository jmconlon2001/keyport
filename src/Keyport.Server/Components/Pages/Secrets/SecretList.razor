@page "/secrets"
@page "/secrets/{EnvName}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AppPageBase
@inject SecretService Secrets

<PageTitle>@(env?.Name ?? "Secrets") · Keyport</PageTitle>

<div class="page-header">
    <div>
        <div class="breadcrumbs"><a href="">Dashboard</a><i class="i i-chevron-right"></i><span>Secrets</span></div>
        <h1>Secrets</h1>
        <p class="page-subtitle">Database logins, passwords and other private values, kept separately for each environment.</p>
    </div>
    @if (env is not null && Access.CanEdit(env.Id))
    {
        <div class="page-actions">
            <a class="btn btn-primary" href="@($"secrets/{env.Name.ToLowerInvariant()}/new")"><i class="i i-plus"></i> Add a secret to @env.Name</a>
        </div>
    }
</div>

<div class="env-tabs">
    @foreach (var e in visible)
    {
        <a class="env-tab @(e.Id == env?.Id ? "active" : "")" style="--env:@e.Color" href="@($"secrets/{e.Name.ToLowerInvariant()}")">
            <span class="env-dot" style="--env:@e.Color"></span>@e.Name @if (e.Protected){<i class="i i-lock"></i>}
            <span class="count">:@e.Port</span>
        </a>
    }
</div>

@if (env is null)
{
    <div class="card"><div class="empty"><i class="i i-lock"></i><h3>No environments available</h3><p>You have not been granted access to any environment.</p></div></div>
}
else
{
    @if (env.Protected)
    {
        <div class="env-banner" style="--env:@env.Color"><i class="i i-alert"></i><div><strong>@env.Name is a protected environment.</strong> You'll be asked for a reason (such as a change ticket) before viewing or changing anything.</div></div>
    }

    <div class="toolbar">
        <div class="input-icon grow">
            <i class="i i-search"></i>
            <input class="form-control" placeholder="Search by name, server, description or tag…" @bind="search" @bind:event="oninput" @bind:after="LoadAsync" />
        </div>
        <div class="segmented" role="tablist">
            <button class="@(type is null ? "active" : "")" @onclick="() => SetType(null)">All</button>
            <button class="@(type == SecretType.OracleConnection ? "active" : "")" @onclick="() => SetType(SecretType.OracleConnection)">Oracle</button>
            <button class="@(type == SecretType.SqlServerConnection ? "active" : "")" @onclick="() => SetType(SecretType.SqlServerConnection)">SQL Server</button>
            <button class="@(type == SecretType.BasicAuth ? "active" : "")" @onclick="() => SetType(SecretType.BasicAuth)">Logins</button>
            <button class="@(type == SecretType.ServiceAccount ? "active" : "")" @onclick="() => SetType(SecretType.ServiceAccount)">Service accounts</button>
            <button class="@(type == SecretType.Generic ? "active" : "")" @onclick="() => SetType(SecretType.Generic)">Other</button>
        </div>
    </div>

    <div class="card card-flush">
        @if (items is null)
        {
            <div class="empty"><div class="spinner-border spinner-border-sm"></div></div>
        }
        else if (items.Count == 0)
        {
            <div class="empty">
                <i class="i i-key"></i>
                <h3>@(string.IsNullOrEmpty(search) && type is null ? $"No secrets in {env.Name} yet" : "No matches")</h3>
                @if (string.IsNullOrEmpty(search) && type is null && Access.CanEdit(env.Id))
                {
                    <p>Add a database login, password or other private value. Nothing can read it until you give an application access.</p>
                    <a class="btn btn-primary mt-2" href="@($"secrets/{env.Name.ToLowerInvariant()}/new")"><i class="i i-plus"></i> Add a secret</a>
                    <div class="mt-2"><a href="help" class="small">How does this work?</a></div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-hover table-clickable table-cards">
                    <thead>
                        <tr><th>Name</th><th>Kind</th><th>Server / address</th><th>Version</th><th>Last changed</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in items)
                        {
                            <tr data-href="@($"secret/{s.Id}")">
                                <td class="td-primary">
                                    <div class="d-flex align-items-center gap-3">
                                        <TypeIcon Type="s.Type" />
                                        <div class="min-w-0">
                                            <div class="cell-main cell-mono">@s.Name</div>
                                            <div class="cell-sub">@(s.Description ?? s.Tags ?? "")</div>
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Kind"><span class="type-chip">@s.Type.FriendlyTitle()</span></td>
                                <td data-label="Server" class="cell-mono">@(s.Host ?? "—")</td>
                                <td data-label="Version"><span class="pill pill-muted">v@(s.CurrentVersion)</span>
                                    @if (s.RotateAfterUtc is { } r && r <= DateTime.UtcNow)
                                    {
                                        <span class="pill pill-warning ms-1" title="A password change was due on @r.ToString("d MMM yyyy")"><i class="i i-clock"></i> change due</span>
                                    }
                                </td>
                                <td data-label="Last changed"><span title="@s.UpdatedUtc.ToString("u")">@Ago(s.UpdatedUtc)</span><div class="cell-sub">@s.UpdatedBy</div></td>
                                <td class="td-actions text-end"><a class="btn btn-sm btn-ghost" href="@($"secret/{s.Id}")">Open <i class="i i-arrow-right"></i></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<ToastHost Items="Toasts" />

@code {
    [Parameter] public string? EnvName { get; set; }

    private List<EnvironmentInfo> visible = [];
    private EnvironmentInfo? env;
    private List<SecretSummary>? items;
    private string? search;
    private SecretType? type;

    protected override Task OnPageInitializedAsync()
    {
        visible = Environments.All.Where(e => Access.CanView(e.Id)).ToList();
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (visible.Count == 0) visible = Environments.All.Where(e => Access.CanView(e.Id)).ToList();
        env = Environments.ByName(EnvName) is { } e && Access.CanView(e.Id) ? e : visible.FirstOrDefault();
        items = null;
        await LoadAsync();
    }

    private async Task SetType(SecretType? t)
    {
        type = t;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (env is null) return;
        items = await Secrets.ListAsync(Access, env.Id, search, type);
    }
}
