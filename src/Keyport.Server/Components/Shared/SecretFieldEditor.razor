@using Keyport.Core.Secrets.Types
@* Renders one field of a secret type from its definition. *@

<div class="@ColumnClass">
    @if (Field.Kind == FieldKind.Bool)
    {
        <div class="form-check form-switch mt-md-4">
            <input class="form-check-input" type="checkbox" id="@ElementId" checked="@SecretFields.IsTrue(Value)" disabled="@Disabled"
                   @onchange="OnToggle" />
            <label class="form-check-label" for="@ElementId">@Field.Label</label>
        </div>
        @if (Field.Help is not null){<div class="form-text">@Field.Help</div>}
    }
    else
    {
        <label class="form-label" for="@ElementId">
            @Field.Label
            @if (Required){<span class="req">*</span>}
            else if (Field.Recommended){<span class="opt">recommended</span>}
            else{<span class="opt">optional</span>}
        </label>
        @switch (Field.Kind)
        {
            case FieldKind.Select:
                <select id="@ElementId" class="form-select" disabled="@Disabled" value="@Value" @onchange="e => Set(e.Value as string)">
                    @if (!Required && Field.Default is null){<option value="">(none)</option>}
                    @foreach (var o in Field.Options){<option value="@o">@o</option>}
                </select>
                break;
            case FieldKind.Multiline:
            case FieldKind.Pem:
                <textarea id="@ElementId" class="form-control mono-input @(NeedsInput ? "needs-input" : "")" rows="@(Field.Kind == FieldKind.Pem ? 6 : 3)"
                          disabled="@Disabled" placeholder="@(Field.Placeholder ?? (Field.Kind == FieldKind.Pem ? "-----BEGIN …-----" : null))" spellcheck="false" autocomplete="off"
                          value="@Value" @oninput="e => Set(e.Value as string)"></textarea>
                break;
            case FieldKind.Password:
                <div class="input-group">
                    <input id="@ElementId" type="@(show ? "text" : "password")" class="form-control mono-input @(NeedsInput ? "needs-input" : "")" disabled="@Disabled"
                           autocomplete="new-password" placeholder="@Field.Placeholder" value="@Value" @oninput="e => Set(e.Value as string)" />
                    <button type="button" class="btn btn-outline-secondary" title="@(show ? "Hide" : "Show")" disabled="@Disabled" @onclick="() => show = !show"><i class="i @(show ? "i-eye-off" : "i-eye")"></i></button>
                    @if (Field.Generate)
                    {
                        <button type="button" class="btn btn-outline-secondary" title="Generate a strong password" disabled="@Disabled" @onclick="GenerateAsync"><i class="i i-shuffle"></i> <span class="d-none d-sm-inline">Generate</span></button>
                    }
                </div>
                break;
            default:
                <input id="@ElementId" class="form-control @(Field.Kind is FieldKind.Host or FieldKind.Url or FieldKind.Port ? "mono-input" : "") @(NeedsInput ? "needs-input" : "")"
                       type="@(Field.Kind is FieldKind.Port or FieldKind.Number ? "number" : "text")" disabled="@Disabled" autocomplete="off"
                       placeholder="@Field.Placeholder" value="@Value" @oninput="e => Set(e.Value as string)" />
                break;
        }
        @if (NeedsInput && NotCopiedMessage is not null){<div class="form-text needs-input-text"><i class="i i-alert"></i> @NotCopiedMessage</div>}
        @if (Field.Help is not null){<div class="form-text">@Field.Help</div>}
    }
</div>

@code {
    [Parameter, EditorRequired] public FieldDefinition Field { get; set; } = default!;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Highlight: this field was not copied from another environment and still needs a value.</summary>
    [Parameter] public bool NeedsInput { get; set; }
    [Parameter] public string? NotCopiedMessage { get; set; }

    /// <summary>Raised after the password generator fills the field (for activity logging).</summary>
    [Parameter] public EventCallback OnGenerated { get; set; }

    private bool show;

    public static string IdFor(string key) => "f-" + key;
    private string ElementId => IdFor(Field.Key);

    private string ColumnClass => Field.Kind switch
    {
        FieldKind.Port or FieldKind.Bool => "col-md-4",
        FieldKind.Multiline or FieldKind.Pem or FieldKind.Url => "col-12",
        _ => Field.Key == "host" ? "col-md-8" : "col-md-6",
    };

    private Task OnToggle(ChangeEventArgs e) => Set(e.Value is true ? "true" : null);

    private Task Set(string? v) => ValueChanged.InvokeAsync(string.IsNullOrEmpty(v) ? null : v);

    private async Task GenerateAsync()
    {
        show = true;
        await Set(Keyport.Core.Crypto.PasswordGenerator.Generate(24));
        await OnGenerated.InvokeAsync();
    }
}
