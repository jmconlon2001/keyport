@page "/Account/Lockout"
@layout SecretManager.Server.Components.Layout.AuthLayout

<PageTitle>Account locked</PageTitle>

<div class="auth-state auth-state-danger"><i class="i i-lock"></i></div>
<h1 class="auth-title">Account locked</h1>
<p class="auth-subtitle">Too many failed attempts. Try again in 15 minutes, or ask an administrator to unlock your account.</p>
<a class="btn btn-outline-secondary w-100" href="">Back to SecretManager</a>
