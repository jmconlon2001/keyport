@inherits LayoutComponentBase

<div class="auth-shell">
    <div class="auth-art" aria-hidden="true">
        <div class="auth-art-inner">
            <span class="brand-mark brand-mark-lg"><i class="i i-shield"></i></span>
            <h2>SecretManager</h2>
            <p>Connection strings and credentials for every environment: encrypted, segmented by port and fully audited.</p>
            <ul class="auth-points">
                <li><i class="i i-lock"></i> AES-256-GCM envelope encryption</li>
                <li><i class="i i-layers"></i> Dev · Test · Upgrade · Prod isolation</li>
                <li><i class="i i-activity"></i> Tamper-evident audit trail</li>
            </ul>
        </div>
    </div>
    <div class="auth-panel">
        <div class="auth-card">
            <div class="auth-brand d-lg-none"><span class="brand-mark"><i class="i i-shield"></i></span> SecretManager</div>
            @Body
        </div>
        <button type="button" class="icon-btn auth-theme" data-theme-toggle title="Toggle theme" aria-label="Toggle theme">
            <i class="i i-moon theme-dark-hide"></i><i class="i i-sun theme-light-hide"></i>
        </button>
    </div>
</div>
