@using SecretManager.Server.Data
@inject EnvironmentRegistry Environments

<div class="sidebar-brand">
    <a href="">
        <span class="brand-mark"><i class="i i-shield"></i></span>
        <span class="brand-text">SecretManager<small>Secrets &amp; connections</small></span>
    </a>
</div>

<nav class="sidebar-nav">
    <AuthorizeView>
        <Authorized>
            <NavLink class="nav-item-link" href="" Match="NavLinkMatch.All"><i class="i i-grid"></i> Dashboard</NavLink>

            <div class="nav-section">Secrets</div>
            <NavLink class="nav-item-link" href="secrets"><i class="i i-key"></i> Secrets</NavLink>
            <NavLink class="nav-item-link" href="compare"><i class="i i-columns"></i> Compare environments</NavLink>
            <NavLink class="nav-item-link" href="clients"><i class="i i-plug"></i> Applications</NavLink>

            <div class="nav-section">Environments</div>
            @foreach (var env in Environments.All)
            {
                <NavLink class="nav-item-link nav-env" href="@($"secrets/{env.Name.ToLowerInvariant()}")">
                    <span class="env-dot" style="--env:@env.Color"></span> @env.Name
                    <span class="nav-meta">:@env.Port</span>
                </NavLink>
            }

            <NavLink class="nav-item-link" href="help"><i class="i i-info"></i> Help &amp; guide</NavLink>

            <div class="nav-section">Monitoring</div>
            <NavLink class="nav-item-link" href="system/status"><i class="i i-gauge"></i> Status</NavLink>
            <NavLink class="nav-item-link" href="system/health"><i class="i i-heart"></i> Health</NavLink>
            <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Auditor}")" Context="auditCtx">
                <NavLink class="nav-item-link" href="activity"><i class="i i-activity"></i> Activity log</NavLink>
                <NavLink class="nav-item-link" href="audit"><i class="i i-file"></i> Audit trail</NavLink>
            </AuthorizeView>

            <AuthorizeView Roles="@Roles.Admin" Context="adminCtx">
                <div class="nav-section">Administration</div>
                <NavLink class="nav-item-link" href="users"><i class="i i-users"></i> Users &amp; access</NavLink>
                <NavLink class="nav-item-link" href="certificates"><i class="i i-award"></i> Certificates</NavLink>
                <NavLink class="nav-item-link" href="proxy"><i class="i i-globe"></i> Reverse proxy</NavLink>
                <a class="nav-item-link" href="openapi/v1.json" target="_blank"><i class="i i-code"></i> OpenAPI spec</a>
            </AuthorizeView>
        </Authorized>
    </AuthorizeView>
</nav>

<AuthorizeView>
    <Authorized>
        <div class="sidebar-footer">
            <a class="sidebar-user" href="Account/Manage">
                <span class="avatar avatar-sm">@(context.User.DisplayName() is { Length: > 0 } dn ? dn[..1].ToUpperInvariant() : "?")</span>
                <span class="sidebar-user-name">@context.User.DisplayName()<small>@(context.User.IsInRole(Roles.Admin) ? "Administrator" : context.User.IsInRole(Roles.Auditor) ? "Auditor" : "Member")</small></span>
            </a>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="" />
                <button type="submit" class="icon-btn icon-btn-dark" title="Sign out"><i class="i i-logout"></i></button>
            </form>
        </div>
    </Authorized>
</AuthorizeView>
