@page "/certificates"
@attribute [Authorize(Roles = SecretManager.Server.Data.Roles.Admin)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits AppPageBase
@using SecretManager.Core.Pki
@using System.Security.Cryptography.X509Certificates
@inject CertificateManager Certs
@inject AuditService Audit

<PageTitle>Certificates · SecretManager</PageTitle>

<div class="page-header">
    <div>
        <h1>Certificates</h1>
        <p class="page-subtitle">Built-in internal CA. The server certificate is issued automatically and renewed at two-thirds of its lifetime without a restart.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" href="ca.crt" download="secretmanager-ca.crt"><i class="i i-download"></i> Download CA certificate</a>
        <button class="btn btn-primary" @onclick="() => confirmRenew = true"><i class="i i-refresh"></i> Renew now</button>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h3><i class="i i-shield"></i> Trust anchor (CA)</h3><span class="pill pill-accent">distribute to clients</span></div>
            <div class="card-body">
                <dl class="kv">
                    <dt>Subject</dt><dd class="cell-mono">@Certs.TrustAnchor.Subject</dd>
                    <dt>Valid</dt><dd>@Certs.TrustAnchor.NotBefore.ToUniversalTime().ToString("yyyy-MM-dd") → @Certs.TrustAnchor.NotAfter.ToUniversalTime().ToString("yyyy-MM-dd")</dd>
                    <dt>Key</dt><dd>@KeyDesc(Certs.TrustAnchor)</dd>
                    <dt>SHA-256</dt><dd class="cell-mono small">@CertificateAuthority.Sha256Fingerprint(Certs.TrustAnchor)</dd>
                </dl>
                <hr />
                <p class="small text-muted mb-2">Install on clients:</p>
                <div class="cs-preview small">
                    # Linux (Debian/Ubuntu)<br />
                    sudo cp secretmanager-ca.crt /usr/local/share/ca-certificates/ &amp;&amp; sudo update-ca-certificates<br /><br />
                    # Windows (admin PowerShell)<br />
                    Import-Certificate -FilePath secretmanager-ca.crt -CertStoreLocation Cert:\LocalMachine\Root
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h3><i class="i i-award"></i> Server certificate</h3><span class="pill @(DaysLeft > 30 ? "pill-success" : "pill-warning")">@DaysLeft days left</span></div>
            <div class="card-body">
                <dl class="kv">
                    <dt>Subject</dt><dd class="cell-mono">@Certs.ServerCertificate.Subject</dd>
                    <dt>Names (SAN)</dt>
                    <dd>
                        <div class="d-flex flex-wrap gap-1">@foreach (var n in Certs.SubjectAlternativeNames){<span class="pill pill-muted cell-mono">@n</span>}</div>
                    </dd>
                    <dt>Valid</dt><dd>@Certs.ServerCertificate.NotBefore.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") → @Certs.ServerCertificate.NotAfter.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</dd>
                    <dt>Renews after</dt><dd>@RenewAt.ToString("yyyy-MM-dd")</dd>
                    <dt>Key</dt><dd>@KeyDesc(Certs.ServerCertificate)</dd>
                    <dt>SHA-256</dt><dd class="cell-mono small">@CertificateAuthority.Sha256Fingerprint(Certs.ServerCertificate)</dd>
                    <dt>Served on</dt><dd>:@Environments.AdminPort (admin) and @string.Join(", ", Environments.All.Select(e => $":{e.Port} ({e.Name})"))</dd>
                </dl>
                <div class="form-text mt-3">Names come from <code>SecretManager:Edge:HostNames</code> / <code>IpAddresses</code>. Changing them issues a new certificate at next start.</div>
            </div>
        </div>
    </div>
</div>

<ConfirmDialog Show="confirmRenew" Title="Renew server certificate" ConfirmText="Renew" Message="Issue a new server certificate now? New TLS handshakes use it immediately; existing connections are unaffected."
               OnConfirm="RenewAsync" OnCancel="() => confirmRenew = false" />

<ToastHost Items="Toasts" />

@code {
    private bool confirmRenew;
    private int DaysLeft => (int)(Certs.ServerCertificate.NotAfter.ToUniversalTime() - DateTime.UtcNow).TotalDays;
    private DateTime RenewAt
    {
        get
        {
            var c = Certs.ServerCertificate;
            return c.NotBefore.ToUniversalTime() + (c.NotAfter - c.NotBefore) * (2.0 / 3.0);
        }
    }

    private static string KeyDesc(X509Certificate2 c)
    {
        using var ec = c.GetECDsaPublicKey();
        if (ec is not null) return $"ECDSA P-{ec.KeySize}";
        using var rsa = c.GetRSAPublicKey();
        return rsa is not null ? $"RSA {rsa.KeySize}" : c.PublicKey.Oid.FriendlyName ?? "unknown";
    }

    private async Task RenewAsync(string? _)
    {
        confirmRenew = false;
        await RunAsync("certificate.renew", async () =>
        {
            Certs.ForceRenew();
            await Audit.WriteAsync(Access.UserName, "certificate.renew", AuditResult.Success, clientIp: Ip, details: "manual");
        }, "New server certificate issued");
    }
}
