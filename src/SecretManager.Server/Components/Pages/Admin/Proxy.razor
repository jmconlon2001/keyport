@page "/proxy"
@attribute [Authorize(Roles = SecretManager.Server.Data.Roles.Admin)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits AppPageBase
@using Microsoft.Extensions.Options
@using SecretManager.Server.Configuration
@using SecretManager.Server.Data
@inject ProxyRouteService ProxyRoutes
@inject IOptions<SecretManagerOptions> Options

<PageTitle>Reverse proxy · SecretManager</PageTitle>

<div class="page-header">
    <div>
        <h1>Reverse proxy</h1>
        <p class="page-subtitle">Publish internal services through SecretManager's TLS edge. Changes apply immediately and are saved in the database, so they survive restarts.</p>
    </div>
    <div class="page-actions"><button class="btn btn-primary" @onclick="NewRoute"><i class="i i-plus"></i> New route</button></div>
</div>

<div class="alert @(allowList.Count > 0 ? "alert-info" : "alert-warning") d-flex gap-2 align-items-start">
    <i class="i i-shield mt-1"></i>
    <div>
        @if (allowList.Count > 0)
        {
            <span><strong>Upstream allow-list active:</strong> <span class="cell-mono">@string.Join(", ", allowList)</span>. Set in <code>SecretManager:Proxy:AllowedUpstreams</code>; it can't be changed from the UI.</span>
        }
        else
        {
            <span><strong>No upstream allow-list configured.</strong> Routes may point at any host this server can reach, except link-local and cloud-metadata addresses. To restrict upstreams, set <code>SecretManager:Proxy:AllowedUpstreams</code>.</span>
        }
    </div>
</div>

<div class="card card-flush mb-4">
    <div class="card-header"><h3><i class="i i-globe"></i> Routes managed here</h3><span class="pill pill-muted">@(routes?.Count ?? 0)</span></div>
    @if (routes is null)
    {
        <div class="empty"><div class="spinner-border spinner-border-sm"></div></div>
    }
    else if (routes.Count == 0)
    {
        <div class="empty"><i class="i i-globe"></i><h3>No proxy routes yet</h3><p>Create a route to forward a path such as <code>/grafana</code> to an internal service.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table-cards">
                <thead><tr><th>Route</th><th>Upstream</th><th>Ports</th><th>Access</th><th>Health</th><th>Req 24h</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in routes)
                    {
                        var health = ProxyRoutes.Health(r);
                        <tr>
                            <td class="td-primary">
                                <div class="cell-main cell-mono">@r.PathPrefix @if (!r.Enabled){<span class="pill pill-muted ms-1">disabled</span>}</div>
                                <div class="cell-sub">@r.Name@(r.Description is null ? "" : $" · {r.Description}")</div>
                            </td>
                            <td data-label="Upstream" class="cell-mono small">
                                @foreach (var d in r.DestinationList){<div>@d</div>}
                                @if (r.DestinationList.Count() > 1){<div class="cell-sub">@r.LoadBalancing</div>}
                            </td>
                            <td data-label="Ports">
                                <div class="d-flex flex-wrap gap-1 justify-content-end justify-content-md-start">
                                    @foreach (var p in r.PortList){<span class="pill @(p == Environments.AdminPort ? "pill-accent" : "pill-muted")">@PortLabel(p)</span>}
                                </div>
                            </td>
                            <td data-label="Access">
                                <span class="pill @(r.Access == ProxyAccess.Anonymous ? "pill-warning" : "pill-success")">@AccessLabel(r.Access)</span>
                                @if (r.RelaxCsp){<div class="cell-sub">relaxed CSP</div>}
                            </td>
                            <td data-label="Health">
                                @if (!r.Enabled){<span class="text-muted">—</span>}
                                else if (r.HealthCheckPath is null){<span class="cell-sub">not probed</span>}
                                else
                                {
                                    @foreach (var h in health)
                                    {
                                        <span class="pill @(h.Health == "Healthy" ? "pill-success" : h.Health == "Unhealthy" ? "pill-danger" : "pill-muted") me-1" title="@h.Address">@h.Health</span>
                                    }
                                }
                            </td>
                            <td data-label="Req 24h">@counts.GetValueOrDefault(r.PathPrefix).ToString("N0")</td>
                            <td class="td-actions text-end">
                                <div class="d-inline-flex gap-1">
                                    @if (r.Enabled && r.PortList.Contains(Environments.AdminPort))
                                    {
                                        <a class="btn btn-sm btn-ghost" href="@($"{r.PathPrefix}/")" target="_blank" title="Open"><i class="i i-link"></i></a>
                                    }
                                    <button class="btn btn-sm btn-ghost" title="Edit" @onclick="() => Edit(r)"><i class="i i-edit"></i></button>
                                    <button class="btn btn-sm btn-ghost" title="@(r.Enabled ? "Disable" : "Enable")" @onclick="() => Ask(r, Pending.Toggle)"><i class="i @(r.Enabled ? "i-x" : "i-check")"></i></button>
                                    <button class="btn btn-sm btn-ghost text-danger" title="Delete" @onclick="() => Ask(r, Pending.Delete)"><i class="i i-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (configRoutes.Count > 0)
{
    <div class="card card-flush">
        <div class="card-header"><h3><i class="i i-file"></i> Routes from configuration</h3><span class="pill pill-muted">read-only</span></div>
        <div class="table-wrap">
            <table class="table table-cards">
                <thead><tr><th>Route id</th><th>Path</th><th>Ports</th><th>Policy</th></tr></thead>
                <tbody>
                    @foreach (var c in configRoutes)
                    {
                        <tr>
                            <td class="td-primary cell-mono">@c.RouteId</td>
                            <td data-label="Path" class="cell-mono">@c.Path</td>
                            <td data-label="Ports">@(c.Ports ?? "none (not served)")</td>
                            <td data-label="Policy">@(c.Policy ?? "anonymous")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-body border-top small text-muted">Defined in the <code>ReverseProxy</code> section of appsettings. Edit the file and restart to change these.</div>
    </div>
}

<Modal Show="editing is not null" Title="@(editingId is null ? "New proxy route" : $"Edit {editing?.PathPrefix}")" Large="true" OnClose="() => editing = null">
    <ChildContent>
        @if (editing is not null)
        {
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label" for="pname">Name</label>
                    <input id="pname" class="form-control mono-input" @bind="editing.Name" disabled="@(editingId is not null)" placeholder="grafana" />
                </div>
                <div class="col-md-7">
                    <label class="form-label" for="pprefix">Path prefix</label>
                    <input id="pprefix" class="form-control mono-input" @bind="editing.PathPrefix" @bind:event="oninput" placeholder="/grafana" />
                    <div class="form-text">Requests to <code>@(string.IsNullOrWhiteSpace(editing.PathPrefix) ? "/prefix" : editing.PathPrefix.TrimEnd('/'))/…</code> are forwarded.</div>
                </div>
                <div class="col-12">
                    <label class="form-label" for="pdesc">Description</label>
                    <input id="pdesc" class="form-control" @bind="editing.Description" placeholder="Monitoring dashboards (team platform)" />
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="pdest">Upstream URL(s)</label>
                    <textarea id="pdest" class="form-control mono-input" rows="2" @bind="editing.Destinations" placeholder="http://grafana.internal:3000/"></textarea>
                    <div class="form-text">One per line. Several upstreams are load-balanced.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="plb">Load balancing</label>
                    <select id="plb" class="form-select" @bind="editing.LoadBalancing">
                        @foreach (var p in ProxyRouteService.LoadBalancingPolicies){<option value="@p">@p</option>}
                    </select>
                </div>
                <div class="col-12">
                    <div class="form-section-title mt-1">Serve on ports</div>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var p in AllPorts())
                        {
                            var port = p;
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@($"port{port}")" checked="@editing.Ports.Contains(port)" @onchange="e => TogglePort(port, (bool)e.Value!)" />
                                <label class="form-check-label" for="@($"port{port}")">@PortLabel(port)</label>
                            </div>
                        }
                    </div>
                    <div class="form-text">The route returns 404 on every other port.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="pacc">Who can use it</label>
                    <select id="pacc" class="form-select" @bind="editing.Access">
                        <option value="@ProxyAccess.SignedIn">Signed-in users (MFA)</option>
                        <option value="@ProxyAccess.Auditors">Admins &amp; Auditors</option>
                        <option value="@ProxyAccess.Admins">Admins only</option>
                        <option value="@ProxyAccess.Anonymous">Anyone who can reach the port</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="phc">Health check path <span class="text-muted fw-normal">(optional)</span></label>
                    <input id="phc" class="form-control mono-input" @bind="editing.HealthCheckPath" placeholder="/api/health" />
                </div>
                <div class="col-12 d-flex flex-wrap gap-4">
                    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="pstrip" @bind="editing.StripPrefix" /><label class="form-check-label" for="pstrip">Strip prefix before forwarding</label></div>
                    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="pcsp" @bind="editing.RelaxCsp" /><label class="form-check-label" for="pcsp">Relax Content-Security-Policy</label></div>
                    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="pen" @bind="editing.Enabled" /><label class="form-check-label" for="pen">Enabled</label></div>
                </div>
                @if (editing.Access == ProxyAccess.Anonymous)
                {
                    <div class="col-12"><div class="alert alert-warning mb-0 small">Anyone who can reach the selected port(s) can use this route without signing in.</div></div>
                }
                @if (tests is not null)
                {
                    <div class="col-12">
                        @foreach (var t in tests)
                        {
                            <div class="d-flex gap-2 align-items-center small"><span class="pill @(t.Success ? "pill-success" : "pill-danger")">@(t.Success ? "OK" : "Failed")</span><span class="cell-mono">@t.Address</span><span class="text-muted">@t.Message · @t.ElapsedMs.ToString("0") ms</span></div>
                        }
                    </div>
                }
                <div class="col-12">
                    <label class="form-label" for="preason">Reason (required)</label>
                    <input id="preason" class="form-control" @bind="editing.Reason" @bind:event="oninput" placeholder="CHG-1234 publish Grafana for platform team" />
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-outline-secondary me-auto" disabled="@Busy" @onclick="TestAsync"><i class="i i-zap"></i> Test upstream</button>
        <button class="btn btn-outline-secondary" @onclick="() => editing = null">Cancel</button>
        <button class="btn btn-primary" disabled="@(Busy || string.IsNullOrWhiteSpace(editing?.Reason))" @onclick="SaveAsync"><i class="i i-check"></i> @(editingId is null ? "Create route" : "Save")</button>
    </Footer>
</Modal>

<ConfirmDialog Show="pending == Pending.Toggle" Title="@(target?.Enabled == true ? "Disable route" : "Enable route")" ConfirmText="@(target?.Enabled == true ? "Disable" : "Enable")" RequireReason="true" Danger="@(target?.Enabled == true)"
               Message="@($"{(target?.Enabled == true ? "Stop" : "Start")} forwarding {target?.PathPrefix}? This takes effect immediately.")" OnConfirm="ToggleAsync" OnCancel="() => pending = Pending.None" />
<ConfirmDialog Show="pending == Pending.Delete" Title="Delete route" ConfirmText="Delete" Danger="true" RequireReason="true"
               Message="@($"Delete the route {target?.PathPrefix}? Requests to it return 404 immediately.")" OnConfirm="DeleteAsync" OnCancel="() => pending = Pending.None" />

<ToastHost Items="Toasts" />

@code {
    private enum Pending { None, Toggle, Delete }
    private List<ProxyRoute>? routes;
    private List<ConfigProxyRoute> configRoutes = [];
    private Dictionary<string, int> counts = [];
    private List<string> allowList = [];
    private SaveProxyRouteRequest? editing;
    private int? editingId;
    private ProxyRoute? target;
    private Pending pending;
    private List<UpstreamTestResult>? tests;

    protected override async Task OnPageInitializedAsync()
    {
        allowList = Options.Value.Proxy.AllowedUpstreams;
        configRoutes = ProxyRoutes.ConfigRoutes();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        routes = await ProxyRoutes.ListAsync(Access);
        counts = await ProxyRoutes.RequestCounts24hAsync(routes.Select(r => r.PathPrefix));
    }

    private IEnumerable<int> AllPorts() => Environments.All.Select(e => e.Port).Prepend(Environments.AdminPort);

    private string PortLabel(int port) =>
        port == Environments.AdminPort ? $"Admin :{port}" : Environments.ByPort(port) is { } e ? $"{e.Name} :{port}" : $":{port}";

    private static string AccessLabel(ProxyAccess a) => a switch
    {
        ProxyAccess.Anonymous => "Anyone",
        ProxyAccess.SignedIn => "Signed-in",
        ProxyAccess.Auditors => "Admins & Auditors",
        _ => "Admins",
    };

    private void NewRoute()
    {
        editingId = null;
        tests = null;
        editing = new SaveProxyRouteRequest { Ports = [Environments.AdminPort] };
    }

    private void Edit(ProxyRoute r)
    {
        editingId = r.Id;
        tests = null;
        editing = new SaveProxyRouteRequest
        {
            Name = r.Name,
            Description = r.Description,
            PathPrefix = r.PathPrefix,
            Destinations = r.Destinations,
            Ports = r.PortList.ToList(),
            Access = r.Access,
            StripPrefix = r.StripPrefix,
            RelaxCsp = r.RelaxCsp,
            LoadBalancing = r.LoadBalancing,
            HealthCheckPath = r.HealthCheckPath,
            Enabled = r.Enabled,
        };
    }

    private void TogglePort(int port, bool on)
    {
        if (editing is null) return;
        if (on && !editing.Ports.Contains(port)) editing.Ports.Add(port);
        if (!on) editing.Ports.Remove(port);
    }

    private void Ask(ProxyRoute r, Pending p)
    {
        target = r;
        pending = p;
    }

    private async Task SaveAsync()
    {
        if (editing is null) return;
        var ok = editingId is null
            ? await RunAsync("proxy.create", () => ProxyRoutes.CreateAsync(Access, editing, Ip), $"Route {editing.PathPrefix} is live", editing.PathPrefix)
            : await RunAsync("proxy.update", () => ProxyRoutes.UpdateAsync(Access, editingId.Value, editing, Ip), "Route updated", editing.PathPrefix);
        if (ok)
        {
            editing = null;
            await LoadAsync();
        }
    }

    private async Task TestAsync()
    {
        if (editing is null) return;
        await RunAsync("proxy.test-upstream", async () => tests = await ProxyRoutes.TestUpstreamsAsync(Access, editing, Ip), null, editing.PathPrefix);
    }

    private async Task ToggleAsync(string? reason)
    {
        pending = Pending.None;
        if (await RunAsync(target!.Enabled ? "proxy.disable" : "proxy.enable", () => ProxyRoutes.SetEnabledAsync(Access, target.Id, !target.Enabled, reason, Ip),
                target.Enabled ? "Route disabled" : "Route enabled", target.PathPrefix))
            await LoadAsync();
    }

    private async Task DeleteAsync(string? reason)
    {
        pending = Pending.None;
        if (await RunAsync("proxy.delete", () => ProxyRoutes.DeleteAsync(Access, target!.Id, reason, Ip), "Route deleted", target?.PathPrefix))
            await LoadAsync();
    }
}
