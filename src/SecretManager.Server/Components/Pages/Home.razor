@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AppPageBase
@inject StatusService StatusService
@inject AuditService Audit
@inject SecretService Secrets

<PageTitle>Dashboard · SecretManager</PageTitle>

<div class="page-header">
    <div>
        <h1>Welcome back, @Access.UserName</h1>
        <p class="page-subtitle">Connection strings and credentials across every environment.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" href="system/status"><i class="i i-gauge"></i> Status</a>
        @if (firstEditable is not null)
        {
            <a class="btn btn-primary" href="@($"secrets/{firstEditable.Name.ToLowerInvariant()}/new")"><i class="i i-plus"></i> New secret</a>
        }
    </div>
</div>

@if (status is null)
{
    <div class="row g-3">
        @for (var i = 0; i < 4; i++)
        {
            <div class="col-md-6 col-xl-3"><div class="card placeholder-glow"><div class="card-body"><span class="placeholder col-6"></span><br /><span class="placeholder col-4 mt-3"></span></div></div></div>
        }
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <a class="card stat-card h-100 text-reset" href="system/health">
                <div class="card-body">
                    <div class="stat-icon"><i class="i i-heart"></i></div>
                    <div class="stat-label">System health</div>
                    <div class="stat-value"><span class="pill @HealthPill(status.Health)">@status.Health</span></div>
                    <div class="stat-foot">Up @Uptime(status.Uptime) · v@(status.Version)</div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="stat-icon"><i class="i i-key"></i></div>
                    <div class="stat-label">Secrets</div>
                    <div class="stat-value">@visibleEnvs.Sum(e => Listener(e)?.Secrets ?? 0)</div>
                    <div class="stat-foot">across @visibleEnvs.Count environments</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="stat-icon"><i class="i i-activity"></i></div>
                    <div class="stat-label">API requests · 24h</div>
                    <div class="stat-value">@visibleEnvs.Sum(e => Listener(e)?.Last24h?.Requests ?? 0).ToString("N0")</div>
                    <div class="stat-foot">@visibleEnvs.Sum(e => (Listener(e)?.Last24h?.ClientErrors ?? 0) + (Listener(e)?.Last24h?.ServerErrors ?? 0)).ToString("N0") errors</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a class="card stat-card h-100 text-reset" href="@(Access.IsAdmin ? "certificates" : "system/status")">
                <div class="card-body">
                    <div class="stat-icon"><i class="i i-award"></i></div>
                    <div class="stat-label">TLS certificate</div>
                    <div class="stat-value">@((int)(status.ServerCertNotAfter - DateTime.UtcNow).TotalDays)d</div>
                    <div class="stat-foot">until expiry · renews automatically</div>
                </div>
            </a>
        </div>
    </div>

    <h2 class="h5 mb-3">Environments</h2>
    <div class="row g-3 mb-4">
        @foreach (var env in visibleEnvs)
        {
            var l = Listener(env);
            <div class="col-md-6 col-xl-3">
                <a class="card env-card h-100" style="--env:@env.Color" href="@($"secrets/{env.Name.ToLowerInvariant()}")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                            <div>
                                <div class="env-name"><span class="env-dot" style="--env:@env.Color"></span>@env.Name</div>
                                <div class="env-port">https://…:@env.Port/api/v1</div>
                            </div>
                            @if (env.Protected)
                            {
                                <span class="pill pill-warning"><i class="i i-lock"></i> Protected</span>
                            }
                            else
                            {
                                <span class="pill pill-muted">@(Access.CanEdit(env.Id) ? "Editor" : "Viewer")</span>
                            }
                        </div>
                        <div class="env-metrics">
                            <div><strong>@(l?.Secrets ?? 0)</strong><span>Secrets</span></div>
                            <div><strong>@(l?.Clients ?? 0)</strong><span>Clients</span></div>
                            <div><strong>@((l?.Last24h?.Requests ?? 0).ToString("N0"))</strong><span>Req 24h</span></div>
                        </div>
                    </div>
                </a>
            </div>
        }
        @if (visibleEnvs.Count == 0)
        {
            <div class="col-12">
                <div class="card"><div class="empty"><i class="i i-lock"></i><h3>No environment access yet</h3><p>Ask an administrator to grant you Viewer or Editor access to an environment.</p></div></div>
            </div>
        }
    </div>

    <div class="row g-3">
        @if (rotationDue.Count > 0)
        {
            <div class="col-xl-6">
                <div class="card h-100">
                    <div class="card-header"><h3><i class="i i-clock"></i> Rotation due</h3><span class="pill pill-warning">@rotationDue.Count</span></div>
                    <div class="card-flush">
                        <table class="table table-hover table-clickable">
                            <tbody>
                                @foreach (var s in rotationDue.Take(8))
                                {
                                    <tr data-href="@($"secret/{s.Id}")">
                                        <td><div class="d-flex align-items-center gap-2"><TypeIcon Type="s.Type" /><div><div class="cell-main">@s.Name</div><div class="cell-sub">due @s.RotateAfterUtc?.ToString("yyyy-MM-dd")</div></div></div></td>
                                        <td class="text-end"><EnvBadge Env="Environments.ById(s.EnvironmentId)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        @if (Access.CanReadAudit)
        {
            <div class="@(rotationDue.Count > 0 ? "col-xl-6" : "col-12")">
                <div class="card h-100">
                    <div class="card-header"><h3><i class="i i-file"></i> Recent audit events</h3><a href="audit" class="btn btn-sm btn-ghost">View all <i class="i i-arrow-right"></i></a></div>
                    <div class="card-flush table-wrap">
                        <table class="table table-cards">
                            <tbody>
                                @foreach (var a in recentAudit)
                                {
                                    <tr>
                                        <td class="td-primary"><div class="cell-main">@a.Action</div><div class="cell-sub">@a.Actor @(a.Target is null ? "" : $"→ {a.Target}")</div></td>
                                        <td data-label="Env">@(a.Environment ?? "—")</td>
                                        <td data-label="Result"><span class="pill @ResultPill(a.Result)">@a.Result</span></td>
                                        <td data-label="When" class="text-end cell-sub" title="@a.TimestampUtc.ToString("u")">@Ago(a.TimestampUtc)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private SystemStatus? status;
    private List<EnvironmentInfo> visibleEnvs = [];
    private EnvironmentInfo? firstEditable;
    private List<SecretManager.Server.Data.AuditEvent> recentAudit = [];
    private List<SecretSummary> rotationDue = [];

    protected override async Task OnPageInitializedAsync()
    {
        visibleEnvs = Environments.All.Where(e => Access.CanView(e.Id)).ToList();
        firstEditable = visibleEnvs.FirstOrDefault(e => Access.CanEdit(e.Id));
        status = await StatusService.GetAsync();
        if (Access.CanReadAudit)
            recentAudit = (await Audit.QueryAsync(new AuditQuery(Take: 8))).Items;
        foreach (var env in visibleEnvs)
            rotationDue.AddRange((await Secrets.ListAsync(Access, env.Id)).Where(s => s.RotateAfterUtc is { } r && r <= DateTime.UtcNow.AddDays(14)));
    }

    private ListenerStatus? Listener(EnvironmentInfo e) => status?.Listeners.FirstOrDefault(l => l.Kind == "environment" && l.Name == e.Name);

    public static string HealthPill(string s) => s switch { "Healthy" => "pill-success", "Degraded" => "pill-warning", _ => "pill-danger" };
    public static string ResultPill(string s) => s switch { "Success" => "pill-success", "Denied" => "pill-danger", _ => "pill-warning" };
    public static string Uptime(TimeSpan t) => t.TotalDays >= 1 ? $"{(int)t.TotalDays}d {t.Hours}h" : t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes}m" : $"{t.Minutes}m";
}
