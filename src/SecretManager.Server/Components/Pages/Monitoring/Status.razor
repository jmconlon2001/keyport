@page "/system/status"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits AppPageBase
@implements IDisposable
@inject StatusService StatusService

<PageTitle>Status · SecretManager</PageTitle>

<div class="page-header">
    <div>
        <h1>Status</h1>
        <p class="page-subtitle">Listeners, traffic and background jobs. Refreshes every 10 seconds. Also available as JSON at <code>/admin/api/status</code>.</p>
    </div>
    <div class="page-actions">
        <span class="topbar-chip"><span class="dot @(status?.Health == "Healthy" ? "dot-live" : status?.Health == "Degraded" ? "dot-warning" : "dot-danger")"></span> @(status?.Health ?? "…")</span>
        <button class="btn btn-outline-secondary" @onclick="LoadAsync"><i class="i i-refresh"></i> Refresh</button>
    </div>
</div>

@if (status is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-icon"><i class="i i-clock"></i></div><div class="stat-label">Uptime</div><div class="stat-value">@Home.Uptime(status.Uptime)</div><div class="stat-foot">since @status.StartedUtc.ToString("yyyy-MM-dd HH:mm") UTC</div></div></div></div>
        <div class="col-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-icon"><i class="i i-server"></i></div><div class="stat-label">Version</div><div class="stat-value">@status.Version</div><div class="stat-foot">.NET @Environment.Version</div></div></div></div>
        <div class="col-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-icon"><i class="i i-database"></i></div><div class="stat-label">Database</div><div class="stat-value">@Size(status.DatabaseBytes)</div><div class="stat-foot">SQLite · WAL</div></div></div></div>
        <div class="col-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-icon"><i class="i i-activity"></i></div><div class="stat-label">Log queue</div><div class="stat-value">@status.ActivityBacklog</div><div class="stat-foot">@status.ActivityDropped dropped</div></div></div></div>
    </div>

    <div class="card card-flush mb-4">
        <div class="card-header"><h3><i class="i i-layers"></i> Listeners</h3><span class="text-muted small">since start · last 24h</span></div>
        <div class="table-wrap">
            <table class="table table-cards">
                <thead><tr><th>Listener</th><th>Port</th><th>Secrets</th><th>Clients</th><th>Requests (24h)</th><th>Errors (24h)</th><th>p50 / p95 / p99</th><th>Last request</th></tr></thead>
                <tbody>
                    @foreach (var l in status.Listeners)
                    {
                        var err = (l.Last24h?.ClientErrors ?? 0) + (l.Last24h?.ServerErrors ?? 0);
                        var req = l.Last24h?.Requests ?? 0;
                        <tr>
                            <td class="td-primary">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="env-dot" style="--env:@l.Color"></span>
                                    <span class="cell-main">@l.Name</span>
                                    <span class="pill pill-muted">@(l.Kind == "environment" ? "HTTPS · API" : l.Kind == "admin" ? "HTTPS · UI" : "HTTP")</span>
                                    @if (l.Protected){<i class="i i-lock text-muted" title="Protected"></i>}
                                </div>
                            </td>
                            <td data-label="Port" class="cell-mono">:@l.Port</td>
                            <td data-label="Secrets">@(l.Kind == "environment" ? l.Secrets : "—")</td>
                            <td data-label="Clients">@(l.Kind == "environment" ? l.Clients : "—")</td>
                            <td data-label="Requests (24h)">@(l.Kind == "environment" ? req.ToString("N0") : "—")</td>
                            <td data-label="Errors (24h)" style="min-width:120px">
                                @if (l.Kind == "environment")
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <span>@err</span>
                                        <div class="bar danger flex-grow-1"><span style="width:@(req == 0 ? 0 : Math.Min(100, err * 100 / req))%"></span></div>
                                    </div>
                                }
                                else { <span>—</span> }
                            </td>
                            <td data-label="Latency" class="cell-mono">@(l.SinceStart is { } m ? $"{m.P50Ms:0.#} / {m.P95Ms:0.#} / {m.P99Ms:0.#} ms" : "—")</td>
                            <td data-label="Last request">@(l.SinceStart?.LastRequestUtc is { } t ? Ago(t) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><h3><i class="i i-award"></i> TLS</h3></div>
                <div class="card-body">
                    <dl class="kv">
                        <dt>Server cert expires</dt><dd>@status.ServerCertNotAfter.ToString("yyyy-MM-dd HH:mm") UTC <span class="text-muted">(@((int)(status.ServerCertNotAfter - DateTime.UtcNow).TotalDays) days, auto-renews)</span></dd>
                        <dt>Names</dt><dd class="cell-mono">@string.Join(", ", status.CertificateNames)</dd>
                        <dt>CA expires</dt><dd>@status.TrustAnchorNotAfter.ToString("yyyy-MM-dd")</dd>
                        <dt>CA fingerprint</dt><dd class="cell-mono small">@status.TrustAnchorFingerprint</dd>
                        <dt>Master key id</dt><dd class="cell-mono">@status.MasterKeyId</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><h3><i class="i i-refresh"></i> Background jobs &amp; retention</h3></div>
                <div class="card-body">
                    <dl class="kv mb-3">
                        @foreach (var j in status.Jobs)
                        {
                            <dt>@j.Job</dt>
                            <dd><span class="pill @(j.Ok ? "pill-success" : "pill-danger")">@(j.Ok ? "OK" : "Failing")</span> <span class="text-muted small">@Ago(j.LastRunUtc)</span> @if (j.Error is not null){<div class="small text-danger">@j.Error</div>}</dd>
                        }
                    </dl>
                    <dl class="kv">
                        <dt>API log retention</dt><dd>@Days(status.Retention.ApiLogRetentionDays)</dd>
                        <dt>UI log retention</dt><dd>@Days(status.Retention.UiLogRetentionDays)</dd>
                        <dt>Audit retention</dt><dd>@Days(status.Retention.AuditRetentionDays)</dd>
                        <dt>Purge interval</dt><dd>every @status.Retention.PurgeIntervalHours h</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

<ToastHost Items="Toasts" />

@code {
    private SystemStatus? status;
    private Timer? timer;

    protected override async Task OnPageInitializedAsync()
    {
        await LoadAsync();
        timer = new Timer(_ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task LoadAsync() => status = await StatusService.GetAsync();

    private static string Size(long b) => b > 1 << 30 ? $"{b / (double)(1 << 30):0.0} GB" : b > 1 << 20 ? $"{b / (double)(1 << 20):0.0} MB" : $"{b / 1024.0:0} KB";
    private static string Days(int d) => d <= 0 ? "keep forever" : $"{d} days";

    public void Dispose() => timer?.Dispose();
}
