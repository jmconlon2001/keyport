@* Confirmation dialog that also collects a reason (mandatory for protected environments). *@
<Modal Show="Show" Title="@Title" OnClose="Cancel">
    <ChildContent>
        @if (Message is not null)
        {
            <p class="mb-3">@Message</p>
        }
        @if (Env is { Protected: true })
        {
            <div class="env-banner" style="--env:@Env.Color"><i class="i i-lock"></i> @Env.Name is protected. A reason is required and will be recorded in the audit trail.</div>
        }
        @if (AskReason || ReasonRequired)
        {
            <label class="form-label" for="confirm-reason">Reason @(ReasonRequired ? "" : "(optional)")</label>
            <input id="confirm-reason" class="form-control" @bind="reason" @bind:event="oninput" placeholder="e.g. CHG-1234 rotate after DBA password reset" maxlength="300" />
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
        <button type="button" class="btn @(Danger ? "btn-danger" : "btn-primary")" disabled="@(ReasonRequired && string.IsNullOrWhiteSpace(reason))" @onclick="Confirm">@ConfirmText</button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string Title { get; set; } = "Are you sure?";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool AskReason { get; set; }
    [Parameter] public EnvironmentInfo? Env { get; set; }

    /// <summary>Force a non-empty reason even outside protected environments.</summary>
    [Parameter] public bool RequireReason { get; set; }

    private bool ReasonRequired => RequireReason || Env is { Protected: true };
    [Parameter] public EventCallback<string?> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string? reason;

    protected override void OnParametersSet()
    {
        if (!Show) reason = null;
    }

    private Task Confirm() => OnConfirm.InvokeAsync(string.IsNullOrWhiteSpace(reason) ? null : reason.Trim());
    private Task Cancel() => OnCancel.InvokeAsync();
}
