<div>
    <div class="form-label mb-1">@Label</div>
    <div class="secret-field">
        <span class="value">@Value</span>
        <button type="button" class="btn" title="Copy @Label" @onclick="() => OnCopy.InvokeAsync((Label, Value))"><i class="i i-copy"></i></button>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<(string Label, string Value)> OnCopy { get; set; }
}
