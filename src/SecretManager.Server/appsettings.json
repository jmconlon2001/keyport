{
  "SecretManager": {
    "DataPath": "/data",
    "MasterKeyFile": "/run/secrets/sm_master_key",
    "BootstrapAdminUser": "admin",
    "Edge": {
      "HttpPort": 8080,
      "AdminPort": 8443,
      "BindAddress": "0.0.0.0",
      "HostNames": [ "localhost", "secretmanager" ],
      "IpAddresses": [ "127.0.0.1" ],
      "ApiRequestsPerMinute": 300
    },
    "Ca": {
      "CommonName": "SecretManager Root CA",
      "RootLifetimeDays": 3650,
      "LeafLifetimeDays": 90
    },
    "Logs": {
      "ApiLogRetentionDays": 90,
      "UiLogRetentionDays": 90,
      "AuditRetentionDays": 0,
      "PurgeIntervalHours": 24
    },
    "Environments": [
      { "Name": "Dev",     "Port": 9443, "Color": "#10b981", "Protected": false },
      { "Name": "Test",    "Port": 9444, "Color": "#3b82f6", "Protected": false },
      { "Name": "Upgrade", "Port": 9445, "Color": "#f59e0b", "Protected": true },
      { "Name": "Prod",    "Port": 9446, "Color": "#ef4444", "Protected": true }
    ]
  },
  "ReverseProxy": {
    "Routes": {},
    "Clusters": {}
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
